# EagleBot — painel Next.js
#
# Modelo RASTREADO no git. Copie pra `.env.local` (ou `.env`) e preencha:
#
#     cp env.example .env.local
#
# Sem o ponto na frente de propósito: a regra `.env*` do .gitignore engole
# qualquer `.env.example`, e um modelo que não chega no clone não documenta
# nada. O worker tem o seu em `server/env.example`.
#
# NUNCA ponha credencial de verdade aqui. Só placeholder.

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-key-aqui
# Service role: só em código de servidor, nunca exposta ao browser.
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui

# ── Ponte com o worker de automações (server/) ────────────────────────────
# URL do bot-server. É o que TODA Server Action usa pra alcançar
# /api/mtproto/enqueue, /api/mtproto/ensure-bot-access e /api/ai/assist.
# O design doc §5.1 chamava isso de BOT_SERVER_URL; o nome que o código lê,
# e o único que funciona, é este.
NEXT_PUBLIC_BOT_SERVER_URL=http://localhost:3001

# Segredo compartilhado com o worker. Precisa ser IDÊNTICO ao
# INTERNAL_API_SECRET de server/.env — os endpoints internos recusam toda
# chamada sem ele, e um segredo vazio NUNCA autoriza (é "não configurado",
# não "aberto"). Vazio aqui = botão de promover o bot e os três botões de
# assistente respondendo 503 pra sempre, o que parece feature quebrada.
# Gere um: `openssl rand -hex 32`
INTERNAL_API_SECRET=

# ── Web Push ──────────────────────────────────────────────────────────────
# A pública do par gerado pro worker (VAPID_PUBLIC_KEY em server/.env).
# Vazia desativa o push silenciosamente.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=


# ══════════════════════════════════════════════════════════════════════════
# BLOCO DO WORKER — só quem sobe com `docker compose up` precisa dele.
# ══════════════════════════════════════════════════════════════════════════
#
# `docker-compose.yml` dá `env_file: .env` pro serviço `eaglebot`, e esse
# `.env` é ESTE aqui, o da raiz. O container NUNCA lê `server/.env` (esse só
# vale pro `npm run dev` rodado de dentro de server/). Então, em deploy com
# Docker, tudo que `server/env.example` documenta precisa estar TAMBÉM neste
# arquivo — senão o worker sobe sem, e as que são opcionais desativam a
# feature caladas.
#
# Foi exatamente assim que "tratamento por IA falhou / GEMINI_API_KEY não
# configurada no worker" apareceu: a chave não estava aqui porque este modelo
# não a mencionava, e `envOptional` não derruba o boot pra avisar.
#
# `server/env.example` continua sendo a referência COMPLETA e comentada.
# Abaixo vai só o mínimo pro container funcionar.

# ── Obrigatórias: sem elas o worker nem sobe (`env()` em server/src/config.ts)
# Note que são nomes SEM o prefixo NEXT_PUBLIC_ — as de cima não servem.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Domínio público do worker, pro Telegram entregar os webhooks.
BASE_WEBHOOK_URL=https://seu-worker.exemplo.com
# (SUPABASE_SERVICE_ROLE_KEY o worker também exige — já está lá em cima.)

# ── MTProto: login de conta, sync de diálogos, clone de canal e campanhas.
# Pegue em https://my.telegram.org → API development tools.
# Sem elas o config cai em apiId=0/hash vazio e NENHUMA operação MTProto
# funciona (clone, campanha agendada, Mass DM).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Gemini: o "tratamento por IA" do rascunho de clone e os três botões de
# assistente do editor de campanha. VAZIA DESATIVA EM SILÊNCIO.
GEMINI_API_KEY=
# Trocável sem deploy. Confira o nome do modelo em ai.google.dev antes de mudar.
GEMINI_MODEL=gemini-3.8-flash

# ── Redis da fila (o compose já sobe o serviço `redis`).
REDIS_URL=redis://redis:6379

# ── Web Push, lado privado (a pública é a NEXT_PUBLIC_ lá de cima).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@exemplo.com

# Recuperacao automatica de bots (Automacoes > Recuperacao de bots): se o
# Telegram derrubar um bot, uma conta MTProto conectada fala com o BotFather,
# cria o substituto e restaura o perfil. Requer migration 076, Redis, conta
# MTProto conectada e GEMINI_API_KEY (sugere o username novo).
#
# A feature e paga: o worker so age para tenant com is_owner ou is_premium
# (migration 055). Com `false` aqui, nem a tela nem o worker fazem nada.
BOT_AUTO_HEAL_ENABLED=true
