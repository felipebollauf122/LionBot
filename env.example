# EagleBot — painel Next.js
#
# Modelo RASTREADO no git. Copie pra `.env.local` (ou `.env`) e preencha:
#
#     cp env.example .env.local
#
# Sem o ponto na frente de propósito: a regra `.env*` do .gitignore engole
# qualquer `.env.example`, e um modelo que não chega no clone não documenta
# nada. O worker tem o seu em `server/env.example`.
#
# NUNCA ponha credencial de verdade aqui. Só placeholder.

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-key-aqui
# Service role: só em código de servidor, nunca exposta ao browser.
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui

# ── Ponte com o worker de automações (server/) ────────────────────────────
# URL do bot-server. É o que TODA Server Action usa pra alcançar
# /api/mtproto/enqueue, /api/mtproto/ensure-bot-access e /api/ai/assist.
# O design doc §5.1 chamava isso de BOT_SERVER_URL; o nome que o código lê,
# e o único que funciona, é este.
NEXT_PUBLIC_BOT_SERVER_URL=http://localhost:3001

# Segredo compartilhado com o worker. Precisa ser IDÊNTICO ao
# INTERNAL_API_SECRET de server/.env — os endpoints internos recusam toda
# chamada sem ele, e um segredo vazio NUNCA autoriza (é "não configurado",
# não "aberto"). Vazio aqui = botão de promover o bot e os três botões de
# assistente respondendo 503 pra sempre, o que parece feature quebrada.
# Gere um: `openssl rand -hex 32`
INTERNAL_API_SECRET=

# ── Web Push ──────────────────────────────────────────────────────────────
# A pública do par gerado pro worker (VAPID_PUBLIC_KEY em server/.env).
# Vazia desativa o push silenciosamente.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
